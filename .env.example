# WaHarness Client Configuration
# Target WhatsApp self-chat JID (auto-detected after QR pairing if omitted)
WAHARNESS_TARGET_JID=
# Optional comma-separated whitelist of authorized sender JIDs
WAHARNESS_ALLOWED_JIDS=
# Optional shared HMAC-SHA256 secret to sign/verify !WAH_ packets
WAHARNESS_HMAC_SECRET=
# Automatically redact API keys/tokens from tool output (1 = on, 0 = off)
WAHARNESS_REDACT_SECRETS=1
# Enable chunked !WAH_CHUNK: transmission for >12 KB tool outputs (1 = on, 0 = off)
WAHARNESS_CHUNKED_RES=0

# Legacy Python Host / Worker Configuration (see r0bledas/WAHA-AGY-Bridge for host setup)
WAHA_BASE_URL=http://localhost:3001
WAHA_API_KEY=your_waha_api_key_here
CONTROLLER_CHAT_ID=your_whatsapp_id@c.us
DEFAULT_AGENT=hermes
HERMES_MODEL=deepseek-flash
